{
  "openapi": "3.0.3",
  "info": {
    "title": "Resource Compass REST API",
    "version": "0.1.0",
    "description": "All mutations require an Origin header matching APP_ORIGIN. Tenant business reads enforce RLS. Rates/history admin-only; dashboard manager/admin-only. USD cents and UTC date-only allocations."
  },
  "servers": [
    {
      "url": "http://localhost:8080"
    }
  ],
  "security": [
    {
      "session": []
    }
  ],
  "components": {
    "securitySchemes": {
      "session": {
        "type": "apiKey",
        "in": "cookie",
        "name": "rc_session"
      }
    }
  },
  "paths": {
    "/health": {
      "get": {
        "summary": "Database health",
        "responses": {
          "200": {
            "description": "Success"
          },
          "400": {
            "description": "Invalid input or foreign reference"
          },
          "401": {
            "description": "Session required"
          },
          "403": {
            "description": "Origin or role denied"
          },
          "404": {
            "description": "Unknown organization or operation"
          },
          "409": {
            "description": "Concurrent update; refresh"
          },
          "500": {
            "description": "Read failure"
          }
        },
        "security": []
      }
    },
    "/auth/request": {
      "post": {
        "summary": "Request email link; identical response for invited/uninvited email",
        "responses": {
          "202": {
            "description": "Success"
          },
          "400": {
            "description": "Invalid input or foreign reference"
          },
          "401": {
            "description": "Session required"
          },
          "403": {
            "description": "Origin or role denied"
          },
          "404": {
            "description": "Unknown organization or operation"
          },
          "409": {
            "description": "Concurrent update; refresh"
          },
          "500": {
            "description": "Read failure"
          },
          "429": {
            "description": "Too many requests; retry in 15 minutes"
          }
        },
        "security": [],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "email": {
                    "type": "string",
                    "format": "email"
                  }
                },
                "required": [
                  "email"
                ]
              }
            }
          }
        }
      }
    },
    "/auth/verify": {
      "post": {
        "summary": "Consume link and set HttpOnly SameSite=Lax session cookie",
        "responses": {
          "200": {
            "description": "Success"
          },
          "400": {
            "description": "Invalid input or foreign reference"
          },
          "401": {
            "description": "Session required"
          },
          "403": {
            "description": "Origin or role denied"
          },
          "404": {
            "description": "Unknown organization or operation"
          },
          "409": {
            "description": "Concurrent update; refresh"
          },
          "500": {
            "description": "Read failure"
          }
        },
        "security": [],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "token": {
                    "type": "string"
                  }
                },
                "required": [
                  "token"
                ]
              }
            }
          }
        }
      }
    },
    "/auth/logout": {
